[Unit]
Description=Madar Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/madar-node-agent
EnvironmentFile=/etc/madar-node-agent/agent.env
ExecStart=/opt/madar-node-agent/venv/bin/python -m madar_agent.service
Restart=on-failure
RestartSec=5s
RuntimeDirectory=madar-node-agent
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/madar-node-agent

[Install]
WantedBy=multi-user.target
