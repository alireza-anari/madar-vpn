[Unit]
Description=Madar Xray Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/test -f /etc/madar-node-agent/xray-config.json
ExecStart=/opt/madar-xray/26.3.27/xray run -c /etc/madar-node-agent/xray-config.json
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

