[Unit]
Description=Madar Xray Runtime
After=network-online.target
After=madar-node-agent.service
Wants=network-online.target
BindsTo=madar-node-agent.service
ConditionPathExists=/etc/madar-node-agent/xray-config.json
ConditionPathExists=/run/madar-node-agent/xray-authorized

[Service]
Type=simple
ExecStartPre=/usr/bin/test -f /etc/madar-node-agent/xray-config.json
ExecStartPre=/usr/bin/test -f /run/madar-node-agent/xray-authorized
ExecStart=/opt/madar-xray/26.3.27/xray run -c /etc/madar-node-agent/xray-config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

