[Unit]
Description=Madar Speed Enforcer Runtime
After=network-online.target
After=madar-node-agent.service
Wants=network-online.target
BindsTo=madar-node-agent.service
ConditionPathExists=/etc/madar-node-agent/speed-enforcer.json
ConditionPathExists=/run/madar-node-agent/speed-enforcer-authorized

[Service]
Type=simple
ReadWritePaths=/run/madar-node-agent
ExecStartPre=/usr/bin/test -f /etc/madar-node-agent/speed-enforcer.json
ExecStartPre=/usr/bin/test -f /run/madar-node-agent/speed-enforcer-authorized
ExecStart=/opt/madar-speed-enforcer/madar-speed-enforcer --config /etc/madar-node-agent/speed-enforcer.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

