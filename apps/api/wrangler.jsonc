{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madar-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "910001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIPTION_RATE_LIMITER",
      "namespace_id": "910002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "NODE_ENROLLMENT_RATE_LIMITER",
      "namespace_id": "910003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PROVIDER_CALLBACK_RATE_LIMITER",
      "namespace_id": "910004",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "910005",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
