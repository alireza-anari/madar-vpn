{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madar-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "910001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIPTION_RATE_LIMITER",
      "namespace_id": "910002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "NODE_ENROLLMENT_RATE_LIMITER",
      "namespace_id": "910003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PROVIDER_CALLBACK_RATE_LIMITER",
      "namespace_id": "910004",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "910005",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "madar-staging",
      "workers_dev": true,
      "vars": {
        "RESEND_FROM": "Madar <onboarding@resend.dev>",
        "MAGIC_LINK_BASE_URL": "https://madar-staging.alirezaanari117.workers.dev"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "09d3d308e97e47eeb22d3b091431cefa"
        }
      ],
      "ratelimits": [
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "920001",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "SUBSCRIPTION_RATE_LIMITER",
          "namespace_id": "920002",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "NODE_ENROLLMENT_RATE_LIMITER",
          "namespace_id": "920003",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "PROVIDER_CALLBACK_RATE_LIMITER",
          "namespace_id": "920004",
          "simple": {
            "limit": 300,
            "period": 60
          }
        },
        {
          "name": "ADMIN_RATE_LIMITER",
          "namespace_id": "920005",
          "simple": {
            "limit": 120,
            "period": 60
          }
        }
      ]
    }
  }
}
