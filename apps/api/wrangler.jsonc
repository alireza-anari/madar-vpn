{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madar-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "910001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIPTION_RATE_LIMITER",
      "namespace_id": "910002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}